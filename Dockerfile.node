# Hardened Node base under rvkmar (npm High CVEs patched). Bump after
# rebuilding/pushing docker/base/Dockerfile.node:
#   docker buildx imagetools inspect rvkmar/ecd-node:24-alpine --format '{{.Manifest.Digest}}'
FROM rvkmar/ecd-node:24-alpine@sha256:6f3300189fd2adfb2c7e106fe494e7f20731d0a55884364306f861a9379590aa AS api
WORKDIR /app

# Install deps
COPY package*.json ./
RUN npm ci --omit=dev

# Copy only server code
COPY server ./server
COPY src/utils ./src/utils

# Ensure users.json is included
# COPY server/users.json ./server/users.json

ENV NODE_ENV=production
EXPOSE 3000

# CMD ["node", "server/index.js"]

CMD ["sh", "-c", "echo '⏳ Waiting for MongoDB...' && until nc -z mongo 27017; do sleep 1; done && echo '✅ Mongo ready. Initializing...' && node server/utils/initMongo.js && echo '🚀 Starting API...' && node server/index.js"]
