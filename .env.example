# Copy this file to .env and fill in real values. .env is gitignored;
# .env.example is committed so the required variables are documented.

# --- Frontend (Vite) ---
VITE_AUTH_URL=/api/users/login

# --- Backend / docker-compose secrets ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# D92: short-lived access tokens; refresh issued alongside login.
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
# Alias kept for older env files — same as ACCESS_TOKEN_EXPIRES_IN.
TOKEN_EXPIRES_IN=15m

# D94: CORS is off in production (compose NODE_ENV=production). Dev-only pin;
# never set to *. Default when unset: http://localhost:5173
# CORS_ORIGIN=http://localhost:5173

# ADR 0007: production database is Mongo only. DB_MODE=json is a test/dev
# harness. NODE_ENV=production refuses it (server/config/storageMode.js).
# Compose pins DB_MODE=mongo. Leave unset to default to mongo.
# DB_MODE=mongo
# MONGO_URI=mongodb://localhost:27017/ecd_assessment

# Sessions. Production (NODE_ENV=production) and DB_MODE=mongo use the Mongo
# `sessions` collection. Unset on `npm run dev` keeps sessions in the ECD
# JSON file so a local db.json still works. Tests set this to memory.
# SESSIONS_BACKEND=json
# SESSIONS_BACKEND=mongo

# Audit log. Same resolution as sessions: production / DB_MODE=mongo use the
# Mongo `auditLog` collection. Unset on `npm run dev` keeps auditLog in the
# ECD JSON file. Unit tests for the seam set AUDITLOG_BACKEND=memory.
# AUDITLOG_BACKEND=json
# AUDITLOG_BACKEND=mongo
# Optional Mongo TTL in days. Unset or 0 = off (default). Do not enable until
# ops picks a window; rating alone adds ~900 human_rating.complete rows/day.
# AUDITLOG_RETENTION_DAYS=0


# D107: scheduled encrypted full backup (compose sets ECD_BACKUP_ENABLED=1).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this value in .env / a secret manager — never paste it into compose YAML.
ECD_BACKUP_ENCRYPTION_KEY=
# ECD_BACKUP_CRON=20 2 * * *
# ECD_BACKUP_RETENTION_DAYS=14
# Crash copies written by saveDB (db.json.<timestamp>), not the encrypted
# full backup. Copy only when the newest snapshot is at least this old.
# 0 copies on every save. Retention keeps this many newest crash copies
# and does not delete other files in the backup folder.
# ECD_SNAPSHOT_INTERVAL_MS=300000
# ECD_SNAPSHOT_KEEP=20
# Optional filesystem materials (usually empty — stimulus is inline on items)
# ECD_MATERIALS_DIR=

MONGO_ROOT_USER=ecd_admin
# Generate with: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
MONGO_ROOT_PASSWORD=

# Optional: pin the seed accounts' initial passwords instead of letting
# server/utils/initMongo.js generate random ones on first run.
# TN roster (5 admins + 38 districts + teachers/students) uses SEED_TEMP_PASSWORD
# when set; otherwise defaults to WalkPass!2026 (temporary — rotate after login).
# SEED_TEMP_PASSWORD=WalkPass!2026
# SEED_ADMIN_PASSWORD=
# SEED_DISTRICT_PASSWORD=
# SEED_TEACHER_PASSWORD=
# SEED_STUDENT_PASSWORD=

# --- R psychometrics service (D61, ADR 0001) ---
# Node talks to R only through the job queue. Never from a session path.
R_BACKEND_URL=http://r-backend:4000
# Optional shared-secret between node and R. /health stays open.
# R_SERVICE_TOKEN=
# Live LSAT7 pipeline (D64): npm run test:lsat7 with R_BACKEND_URL pointing
# at a running plumber (compose default is the published image). Unset, the
# contract-path half of that file still runs under npm test.

# D87: concurrency + queue pressure (compose sets these on the node service).
# CALIBRATION_MAX_CONCURRENT=1
# CALIBRATION_QUEUE_DEPTH_ALARM=20
# R_WORKERS=1
# Optional: R_BACKEND_KILL_COMMAND / R_BACKEND_CONTAINER for D86 timeout kill.
